    "userAvatar": "",
    "text": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"theme-color\" content=\"#08080a\">\n    <title>404 — Halaman tidak ditemukan</title>\n    <link rel=\"icon\" href=\"https://raw.githubusercontent.com/kepocodeid/testeraja/refs/heads/main/138.199/logo.jpg\" type=\"image/jpeg\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        *, *::before, *::after {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        :root {\n            --bg: #08080a;\n            --fg: #ededef;\n            --fg-muted: #8b8b8f;\n            --fg-dim: #5c5c60;\n            --border: rgba(255, 255, 255, 0.08);\n            --border-hover: rgba(255, 255, 255, 0.18);\n            --surface: rgba(255, 255, 255, 0.03);\n            --accent: #ff6b6b;\n            --ease: cubic-bezier(0.4, 0, 0.2, 1);\n        }\n\n        html, body {\n            height: 100%;\n        }\n\n        body {\n            background: var(--bg);\n            color: var(--fg);\n            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;\n            font-feature-settings: 'cv11', 'ss01';\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n            text-rendering: optimizeLegibility;\n            overflow-x: hidden;\n            position: relative;\n            min-height: 100vh;\n        }\n\n        /* Grid pattern dengan fade radial */\n        body::before {\n            content: '';\n            position: fixed;\n            inset: 0;\n            background-image:\n                linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),\n                linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);\n            background-size: 64px 64px;\n            -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000 30%, transparent 100%);\n            mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000 30%, transparent 100%);\n            pointer-events: none;\n            z-index: 0;\n        }\n\n        /* Glow ambient di atas */\n        body::after {\n            content: '';\n            position: fixed;\n            top: -30%;\n            left: 50%;\n            transform: translateX(-50%);\n            width: 900px;\n            height: 900px;\n            background: radial-gradient(circle, rgba(255, 107, 107, 0.14), transparent 60%);\n            pointer-events: none;\n            z-index: 0;\n            filter: blur(60px);\n        }\n\n        .nav {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            padding: 28px 40px;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            z-index: 10;\n        }\n\n        .brand {\n            display: inline-flex;\n            align-items: center;\n            gap: 10px;\n            text-decoration: none;\n            color: var(--fg);\n            font-size: 14px;\n            font-weight: 600;\n            letter-spacing: -0.01em;\n            transition: opacity 0.2s var(--ease);\n        }\n\n        .brand:hover {\n            opacity: 0.7;\n        }\n\n        .brand img {\n            width: 28px;\n            height: 28px;\n            border-radius: 7px;\n            object-fit: cover;\n            border: 1px solid var(--border);\n        }\n\n        main {\n            position: relative;\n            z-index: 1;\n            min-height: 100vh;\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            text-align: center;\n            padding: 140px 24px 100px;\n        }\n\n        .badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 8px;\n            padding: 6px 14px;\n            border: 1px solid var(--border);\n            border-radius: 100px;\n            background: var(--surface);\n            backdrop-filter: blur(8px);\n            -webkit-backdrop-filter: blur(8px);\n            font-family: 'JetBrains Mono', ui-monospace, 'SF Mono', Monaco, monospace;\n            font-size: 11px;\n            font-weight: 500;\n            color: var(--fg-muted);\n            letter-spacing: 0.04em;\n            text-transform: uppercase;\n            margin-bottom: 40px;\n            animation: fadeUp 0.6s var(--ease) both;\n        }\n\n        .badge .dot {\n            width: 6px;\n            height: 6px;\n            border-radius: 50%;\n            background: var(--accent);\n            box-shadow: 0 0 10px rgba(255, 107, 107, 0.7);\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; transform: scale(1); }\n            50% { opacity: 0.5; transform: scale(1.2); }\n        }\n\n        .code-wrap {\n            position: relative;\n            margin-bottom: 24px;\n        }\n\n        .code {\n            font-family: 'JetBrains Mono', ui-monospace, 'SF Mono', Monaco, monospace;\n            font-size: clamp(110px, 22vw, 220px);\n            font-weight: 700;\n            line-height: 0.85;\n            letter-spacing: -0.06em;\n            background: linear-gradient(\n                180deg,\n                #ffffff 0%,\n                #ffffff 45%,\n                rgba(255, 255, 255, 0.05) 100%\n            );\n            -webkit-background-clip: text;\n            background-clip: text;\n            -webkit-text-fill-color: transparent;\n            color: transparent;\n            user-select: none;\n            animation: fadeUp 0.7s var(--ease) 0.1s both;\n        }\n\n        .title {\n            font-size: clamp(24px, 3.5vw, 36px);\n            font-weight: 700;\n            letter-spacing: -0.03em;\n            line-height: 1.15;\n            color: var(--fg);\n            margin-bottom: 18px;\n            animation: fadeUp 0.7s var(--ease) 0.15s both;\n        }\n\n        .desc {\n            font-size: 15px;\n            line-height: 1.65;\n            color: var(--fg-muted);\n            max-width: 460px;\n            margin-bottom: 44px;\n            animation: fadeUp 0.7s var(--ease) 0.2s both;\n        }\n\n        .desc code {\n            font-family: 'JetBrains Mono', ui-monospace, 'SF Mono', Monaco, monospace;\n            font-size: 13px;\n            padding: 2px 8px;\n            border-radius: 5px;\n            background: rgba(255, 255, 255, 0.05);\n            color: var(--fg);\n            border: 1px solid var(--border);\n            word-break: break-all;\n        }\n\n        .actions {\n            display: flex;\n            gap: 12px;\n            flex-wrap: wrap;\n            justify-content: center;\n            animation: fadeUp 0.7s var(--ease) 0.25s both;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            gap: 8px;\n            padding: 0 22px;\n            height: 44px;\n            border-radius: 10px;\n            font-family: inherit;\n            font-size: 14px;\n            font-weight: 600;\n            letter-spacing: -0.005em;\n            text-decoration: none;\n            border: 1px solid transparent;\n            cursor: pointer;\n            transition: all 0.2s var(--ease);\n            white-space: nowrap;\n        }\n\n        .btn svg {\n            width: 15px;\n            height: 15px;\n            flex-shrink: 0;\n        }\n\n        .btn-primary {\n            background: var(--fg);\n            color: var(--bg);\n        }\n\n        .btn-primary:hover {\n            background: #ffffff;\n            transform: translateY(-1px);\n            box-shadow: 0 8px 24px rgba(255, 255, 255, 0.14);\n        }\n\n        .btn-primary:active {\n            transform: translateY(0);\n        }\n\n        .btn-ghost {\n            background: transparent;\n            color: var(--fg-muted);\n            border-color: var(--border);\n        }\n\n        .btn-ghost:hover {\n            background: var(--surface);\n            color: var(--fg);\n            border-color: var(--border-hover);\n        }\n\n        .footer {\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            right: 0;\n            padding: 24px 40px;\n            text-align: center;\n            font-family: 'JetBrains Mono', ui-monospace, 'SF Mono', Monaco, monospace;\n            font-size: 11px;\n            color: var(--fg-dim);\n            letter-spacing: 0.04em;\n            z-index: 10;\n        }\n\n        .footer span {\n            display: inline-block;\n        }\n\n        .footer .sep {\n            margin: 0 10px;\n            opacity: 0.5;\n        }\n\n        .sr-only {\n            position: absolute;\n            width: 1px;\n            height: 1px;\n            padding: 0;\n            margin: -1px;\n            overflow: hidden;\n            clip: rect(0, 0, 0, 0);\n            white-space: nowrap;\n            border: 0;\n        }\n\n        @keyframes fadeUp {\n            from {\n                opacity: 0;\n                transform: translateY(12px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @media (max-width: 640px) {\n            .nav {\n                padding: 20px 20px;\n            }\n\n            .brand span {\n                display: none;\n            }\n\n            main {\n                padding: 120px 20px 80px;\n            }\n\n            .badge {\n                font-size: 10px;\n                padding: 5px 12px;\n                margin-bottom: 32px;\n            }\n\n            .desc {\n                font-size: 14px;\n                margin-bottom: 36px;\n            }\n\n            .actions {\n                width: 100%;\n                flex-direction: column-reverse;\n            }\n\n            .btn {\n                width: 100%;\n            }\n\n            .footer {\n                padding: 20px;\n                font-size: 10px;\n            }\n\n            .footer .sep {\n                margin: 0 6px;\n            }\n        }\n\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n    </style>\n</head>\n<body>\n    <nav class=\"nav\">\n        <a href=\"/\" class=\"brand\">\n            <img src=\"https://raw.githubusercontent.com/kepocodeid/testeraja/refs/heads/main/138.199/logo.jpg\" alt=\"Waifu Gallery\">\n            <span>Waifu Gallery</span>\n        </a>\n    </nav>\n\n    <main>\n        <div class=\"badge\">\n            <span class=\"dot\"></span>\n            404 · Not Found\n        </div>\n\n        <div class=\"code-wrap\">\n            <div class=\"code\" aria-hidden=\"true\">404</div>\n            <h1 class=\"sr-only\">Halaman tidak ditemukan</h1>\n        </div>\n\n        <h2 class=\"title\">Halaman ini tidak ada</h2>\n\n        <p class=\"desc\">\n            Alamat <code id=\"tried-path\">/…</code> tidak dapat ditemukan di sistem kami.\n            Mungkin sudah dipindahkan, dihapus, atau memang tidak pernah ada.\n        </p>\n\n        <div class=\"actions\">\n            <button class=\"btn btn-ghost\" id=\"copy-btn\" type=\"button\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n                    <rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"></rect>\n                    <path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path>\n                </svg>\n                <span>Salin URL</span>\n            </button>\n            <a href=\"/\" class=\"btn btn-primary\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n                    <path d=\"M19 12H5M12 19l-7-7 7-7\"></path>\n                </svg>\n                Kembali ke Gallery\n            </a>\n        </div>\n    </main>\n\n    <footer class=\"footer\">\n        <span>404</span>\n        <span class=\"sep\">·</span>\n        <span>Waifu Gallery</span>\n    </footer>\n\n    <script>\n        (function () {\n            var raw = (location.pathname || '/') + (location.search || '');\n            var el = document.getElementById('tried-path');\n            if (el) {\n                var display = raw.length > 42 ? raw.slice(0, 42) + '…' : raw;\n                el.textContent = display;\n            }\n\n            var copyBtn = document.getElementById('copy-btn');\n            if (copyBtn) {\n                copyBtn.addEventListener('click', function () {\n                    var label = copyBtn.querySelector('span');\n                    var original = 'Salin URL';\n\n                    function reset(text) {\n                        label.textContent = text;\n                        setTimeout(function () { label.textContent = original; }, 1600);\n                    }\n\n                    var url = location.href;\n                    if (navigator.clipboard && navigator.clipboard.writeText) {\n                        navigator.clipboard.writeText(url).then(function () {\n                            reset('Tersalin!');\n                        }).catch(function () {\n                            reset('Gagal menyalin');\n                        });\n                    } else {\n                        try {\n                            var ta = document.createElement('textarea');\n                            ta.value = url;\n                            ta.style.position = 'fixed';\n                            ta.style.opacity = '0';\n                            document.body.appendChild(ta);\n                            ta.select();\n                            document.execCommand('copy');\n                            document.body.removeChild(ta);\n                            reset('Tersalin!');\n                        } catch (e) {\n                            reset('Gagal menyalin');\n                        }\n                    }\n                });\n            }\n        })();\n    </script>\n</body>\n</html>\n",
